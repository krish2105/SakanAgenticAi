# --- Backend API ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- SEO / canonical URLs (used in metadata, sitemap, robots) ---------------
NEXT_PUBLIC_SITE_URL=https://sakan-agentic-ai.vercel.app

# --- Product analytics (optional; free tier, no card) ------------------------
# Every capture() call in lib/analytics.ts is a no-op when this is unset, so
# the app works identically without it. Get a key at posthog.com/signup
# (1M events/month free) -- Project Settings -> Project API Key.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Contact-sales lead capture (optional; free CRM tier, no card) ----------
# ContactSalesClient falls back to a mailto: link when either is unset, so
# the page still works without a HubSpot account. Free CRM at hubspot.com
# (API access on every plan) -- Portal ID is in your account URL; Form ID
# comes from the form you create under Marketing > Forms.
# NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# NEXT_PUBLIC_HUBSPOT_FORM_ID=

# --- Bot protection on register/login (optional; free, unlimited, no card) --
# TurnstileWidget renders nothing when this is unset, so the forms work
# identically without it. Get a site key at dash.cloudflare.com -> Turnstile
# (no need to route this app's traffic through Cloudflare's CDN/DNS -- the
# widget calls Cloudflare directly). Must match the backend's
# TURNSTILE_SECRET_KEY (same Cloudflare Turnstile "widget").
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
