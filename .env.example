# Sakan AI backend environment variables.
# Copy to .env for local dev. In production these are set on the host (Render
# dashboard / render.yaml sync:false vars), NOT committed. See render.yaml's
# header and backend/app/config.py for the authoritative list.

# --- Deployment environment -------------------------------------------------
# "development" (default) keeps dev conveniences; "production" fails closed on
# missing JWT/webhook secrets (see backend/app/config.py _validate_production_config).
SAKAN_ENV=development

# --- Core datastores --------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://sakan:sakan@localhost:5432/sakan
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                     # required for Qdrant Cloud, unused for self-hosted
REDIS_URL=                          # optional; unset => in-memory WS pub/sub + market/comps cache
                                     # (single instance only). Free option: Upstash
                                     # (console.upstash.com, 256MB/500K commands/month, no card) --
                                     # paste its rediss:// connection string here. Also backs
                                     # app/cache.py's short-TTL cache for /market/*, /comps.

# --- Auth -------------------------------------------------------------------
JWT_SECRET_KEY=                     # REQUIRED in production. Generate: openssl rand -hex 32
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60   # short-lived; frontend refreshes silently
# REFRESH_TOKEN_EXPIRE_DAYS=30
# MAX_FAILED_LOGINS=5                 # account lockout threshold
# ACCOUNT_LOCKOUT_MINUTES=15
# EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
# PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# --- Transactional email (password reset / verification) --------------------
# Default "console" logs the link instead of sending (works free, zero creds).
# "resend" is the easiest real option: resend.com/signup, free tier is 3,000
# emails/month permanent, no card. "smtp" works with any relay (Postmark, SES,
# Gmail app-password, etc.)
EMAIL_PROVIDER=console               # console | resend | smtp
# EMAIL_FROM=Sakan AI <no-reply@sakan.ai>
# RESEND_API_KEY=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=

# --- LLM (optional; every agent has a deterministic fallback) ---------------
# Anthropic wins if both are set (higher quality). GEMINI_API_KEY alone is
# enough to get real LLM reasoning at zero cost -- Google AI Studio's free
# tier (aistudio.google.com/apikey, no card) covers a pilot's worth of
# traffic. See app/llm.py for the dispatch logic.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# SAKAN_QUERY_MODEL=claude-haiku-4-5-20251001       # or gemini-2.5-flash
# SAKAN_REASONING_MODEL=claude-sonnet-5              # or gemini-2.5-flash

# --- Frontend / CORS --------------------------------------------------------
CORS_ORIGINS=http://localhost:3000  # comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:3000  # Stripe Checkout success/cancel redirect base

# --- Semantic embeddings ----------------------------------------------------
# Auto-enabled the moment GEMINI_API_KEY (above) is set -- Gemini's free
# embedding API (app/embeddings.py) runs on Google's infrastructure, not this
# process, so it has no local RAM cost and works on the smallest free-tier
# box. Leave this unset in that case. Set explicitly to "false" to disable
# semantic RAG even with a Gemini key on hand, or to "true" to force the
# local sentence-transformers/torch model instead (needs real RAM headroom --
# it alone can exceed a 512MB free-tier box).
# ENABLE_SEMANTIC_EMBEDDINGS=

# --- Billing (optional; unset => /billing/checkout|portal return 501) -------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # REQUIRED in production if STRIPE_SECRET_KEY is set
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# --- WhatsApp Business Cloud API (optional) ---------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                # REQUIRED in production if WhatsApp is configured
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Data source (Phase D) --------------------------------------------------
DATA_SOURCE=synthetic               # synthetic | dld_kaggle | licensed_partner
LICENSED_DATA_FEED_URL=
LICENSED_DATA_FEED_API_KEY=
# Only used by scripts/ingest_dld_open_api.py (a standalone batch job, not
# read by the live web service) -- free, official Dubai Pulse "Transactions"
# dataset access. Register at dubaipulse.gov.ae; the key/secret arrive by
# email once the dataset is granted.
DLD_OPEN_DATA_API_KEY=
DLD_OPEN_DATA_API_SECRET=

# --- Observability ----------------------------------------------------------
# LOG_LEVEL=INFO                    # DEBUG|INFO|WARNING|ERROR
# LOG_FORMAT=json                   # "json" (default) or "plain" for local dev
SENTRY_DSN=                         # optional; unset => error tracking disabled
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Data retention ---------------------------------------------------------
# PII_RETENTION_DAYS=180            # used by scripts/purge_old_deal_queries.py
